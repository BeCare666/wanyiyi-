# API Wanyiyi : copier ce fichier en .env et compléter. Ne jamais versionner .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Supabase. La clé service role est réservée aux tâches système (chaque usage est journalisé).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secrets des Auth Hooks (tableau de bord Supabase > Authentication > Hooks), format v1,whsec_...
# Send SMS Hook   -> https://<api>/api/hooks/auth/sms
# Send Email Hook -> https://<api>/api/hooks/auth/email
SEND_SMS_HOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=

# Adaptateurs : simulated (développement, le code s'affiche dans le journal) ou réel (brevo, kkiapay).
# « simulated » est refusé en production.
SMS_PROVIDER=simulated
EMAIL_PROVIDER=simulated
PAYMENT_PROVIDER=simulated

# Brevo : codes OTP par SMS et e-mails de confirmation d'adresse
BREVO_API_KEY=
# Nom d'expéditeur des SMS : 11 lettres ou chiffres au maximum (à confirmer, question 14)
BREVO_SMS_SENDER=
# Adresse d'expédition des e-mails (domaine à authentifier chez Brevo, question 14)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Wanyiyi

# Cloudinary : photos de la vitrine uniquement (jamais de photos de membres)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# KkiaPay (retenu le 20 octobre 2026) : clés du tableau de bord ; PAYMENT_PROVIDER=kkiapay pour les utiliser.
# KKIAPAY_SANDBOX=true : bac à sable (interdit en production).
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true
