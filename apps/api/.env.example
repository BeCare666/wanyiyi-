# API Ifedele : copier ce fichier en .env et compléter. Ne jamais versionner .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Supabase. La clé service role est réservée aux tâches système (chaque usage est journalisé).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secrets des Auth Hooks (tableau de bord Supabase > Authentication > Hooks), format v1,whsec_...
# Send Email Hook -> https://<api>/api/hooks/auth/email (inscription, mot de passe oublié ; requis en production)
# Send SMS Hook   -> https://<api>/api/hooks/auth/sms (plus utilisé depuis le 20 octobre 2026, facultatif)
SEND_SMS_HOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=

# Adaptateurs : simulated (développement, le code s'affiche dans le journal) ou réel (brevo, feexpay).
# « simulated » est refusé en production.
# Canal SMS coupé le 20 octobre 2026 : disabled (aucun SMS). brevo ou simulated seulement si on le rétablit.
SMS_PROVIDER=disabled
EMAIL_PROVIDER=simulated
PAYMENT_PROVIDER=simulated

# Brevo : codes OTP par SMS et e-mails de confirmation d'adresse
BREVO_API_KEY=
# Nom d'expéditeur des SMS : 11 lettres ou chiffres au maximum (à confirmer, question 14)
BREVO_SMS_SENDER=
# Adresse d'expédition des e-mails (domaine à authentifier chez Brevo, question 14)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ifedele

# Cloudinary : photos de la vitrine uniquement (jamais de photos de membres)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# FeexPay (retenu le 22 octobre 2026, à la place de KkiaPay) : PAYMENT_PROVIDER=feexpay pour l'utiliser.
# Clé privée (test_key_... en bac à sable) et identifiant public de la boutique (champ « shop »),
# menu Développeurs du tableau de bord. FEEXPAY_SANDBOX=true : bac à sable (interdit en production).
# Webhook (tableau de bord FeexPay > Webhook) : https://<api>/api/payments/feexpay/webhook
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
FEEXPAY_SANDBOX=true
